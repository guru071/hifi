{
  "expo": {
    "name": "hifi-mobile-admin",
    "slug": "hifi-mobile-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tech.goat.hifiadmin"
    },
    "android": {
      "allowBackup": false,
      "usesCleartextTraffic": false,
      "package": "tech.goat.hifiadmin",
      "adaptiveIcon": {
        "backgroundColor": "#1a1a1a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "hifi-admin",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85ef0e8b-b1eb-4752-9b24-7eb3268840c1"
      }
    },
    "owner": "greatest-of-all-time-technology"
  }
}
